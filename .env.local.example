# =========================================================
# BASE DE DATOS
# =========================================================
# Conexión local a MongoDB.
# Nombre de la base de datos: soft-gestion-isp-core
MONGODB_URI=mongodb://127.0.0.1:27017/soft-gestion-isp-core


# =========================================================
# AUTENTICACIÓN / SESIONES
# =========================================================
# Clave privada para firmar/verificar sesiones o tokens.
# En producción debería ser una clave larga, segura y difícil de adivinar.
AUTH_SECRET=Diego332022lenovo


# =========================================================
# CONFIGURACIÓN PÚBLICA DE LA APP
# =========================================================
# Nombre visible de la aplicación.
NEXT_PUBLIC_APP_NAME=Soft Gestión ISP

# Nombre visible del ISP dentro del sistema.
NEXT_PUBLIC_ISP_NAME=Nombre del ISP

# Email de soporte que puede mostrarse en la app.
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@isp.com

# Teléfono de soporte que puede mostrarse en la app.
NEXT_PUBLIC_SUPPORT_PHONE=+54 000 000000


# =========================================================
# URL PÚBLICA DEL SISTEMA
# =========================================================
# URL base usada para generar links públicos, comprobantes o accesos externos.
# En desarrollo local:
APP_PUBLIC_URL=http://localhost:3000

# En producción o acceso externo, usarías algo como:
# APP_PUBLIC_URL=http://190.221.47.106:3000


# =========================================================
# COMPROBANTES / VERIFICACIÓN PÚBLICA
# =========================================================
# Clave privada para firmar comprobantes y validar que no fueron alterados.
# No debe compartirse ni exponerse en el frontend.
COMPROBANTE_SECRET=una_clave_larga_privada_para_firmar_comprobantes


# =========================================================
# ADMINISTRADORES PROTEGIDOS
# =========================================================
# Estos dos usuarios son administradores principales del sistema.
# No podrán ser suspendidos, editados ni reseteados por otros admins.
# Solo podrán cambiar su propia contraseña desde "Cambiar contraseña".

# Administrador protegido 1
ADMIN_1_NAME=Diego
ADMIN_1_LASTNAME=Cardenes
ADMIN_1_DNI=00000001
ADMIN_1_EMAIL=armandie2018@gmail.com
ADMIN_1_PASSWORD=Diego332022lenovo

# Administrador protegido 2
ADMIN_2_NAME=Administrador
ADMIN_2_LASTNAME=Principal
ADMIN_2_DNI=00000002
ADMIN_2_EMAIL=admin2@tu-isp.com
ADMIN_2_PASSWORD=Diego332022lenovo


